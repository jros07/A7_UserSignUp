<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="lopezrjo_7_UserSignUp_URINav.SignupPage"
             Title="Sign Up">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="18">

            <!-- Header -->
            <Label Text="Create Account"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,20,0,10"/>

            <Label Text="Sign up to get started"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <!-- Username -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Username"
                       FontSize="14"
                       FontAttributes="Bold"/>
                <Border Stroke="LightGray"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,2">
                    <Entry x:Name="EntryUsername"
                           Placeholder="Enter your username"/>
                </Border>
            </VerticalStackLayout>

            <!-- Email -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Email"
                       FontSize="14"
                       FontAttributes="Bold"/>
                <Border Stroke="LightGray"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,2">
                    <Entry x:Name="EntryEmail"
                           Placeholder="Enter your email"
                           Keyboard="Email"/>
                </Border>
            </VerticalStackLayout>

            <!-- Password -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Password"
                       FontSize="14"
                       FontAttributes="Bold"/>
                <Border Stroke="LightGray"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,2">
                    <Entry x:Name="EntryPassword"
                           Placeholder="Enter your password"
                           IsPassword="True"/>
                </Border>
            </VerticalStackLayout>

            <!-- Confirm Password -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Confirm Password"
                       FontSize="14"
                       FontAttributes="Bold"/>
                <Border Stroke="LightGray"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,2">
                    <Entry x:Name="EntryConfirmPassword"
                           Placeholder="Re-enter your password"
                           IsPassword="True"/>
                </Border>
            </VerticalStackLayout>

            <!-- Inline error message. Hidden by default; shown when validation fails. -->
            <Label x:Name="LblError"
                   TextColor="Red"
                   FontSize="13"
                   IsVisible="False"
                   HorizontalOptions="Center"/>

            <!-- Sign Up button -->
            <Button x:Name="BtnSignUp"
                    Text="Sign Up"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="25"
                    BackgroundColor="#5E35B1"
                    TextColor="White"
                    Margin="0,15,0,0"
                    Clicked="BtnSignUp_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>